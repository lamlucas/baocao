    payNote = `L\u01B0\u01A1ng th\xE1ng hi\u1EC7n t\u1EA1i \u2014 t\xEDnh t\u1EDBi ng\xE0y ${String(d).padStart(2, "0")}/${mo}/${yr}`;
    label = `${formatMonthLabel(monthIso)} (t\u1EDBi ng\xE0y ${String(d).padStart(2, "0")}/${mo})`;
